rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owner(uid) {
      return verified() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owner(uid);

      // Signup creates a minimal user profile before email verification.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;

      allow update: if owner(uid)
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;

      allow delete: if false;

      match /savedRooms/{roomId} {
        allow read, create, update, delete: if owner(uid);
      }

      match /bookings/{bookingId} {
        allow read: if owner(uid);

        allow create: if owner(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.ownerEmail == request.auth.token.email
          && request.resource.data.status == 'Requested'
          && request.resource.data.total is int
          && request.resource.data.total >= 0
          && request.resource.data.guests is int
          && request.resource.data.guests > 0
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() > 0
          && request.resource.data.guestPhone is string
          && request.resource.data.guestPhone.size() >= 7;

        allow update: if owner(uid)
          && resource.data.ownerUid == uid
          && resource.data.ownerEmail == request.auth.token.email
          && request.resource.data.ownerUid == uid
          && request.resource.data.ownerEmail == request.auth.token.email
          && resource.data.status != 'Cancelled'
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['status', 'updatedAt']);

        allow delete: if false;
      }
    }
  }
}
